# ---------------------------------------------------------------------------------------
# AutoQuote AI - environment template. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------------------

# Any OpenAI-compatible endpoint. Default: Groq free tier (https://console.groq.com/keys).
# Leave LLM_API_KEY empty to run fully offline with the deterministic rule-based extractor.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Other free options:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#   Ollama:     LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama

QUOTE_SERVICE_URL=http://quote-service:8000
LOG_LEVEL=INFO
LOG_FILE=logs/execution.log
# development | test | production  (production requires PII_ENCRYPTION_KEY and ADMIN_API_KEY,
# and disables the `?sync=true` webhook debug mode)
ENVIRONMENT=development

# Resilience policy for the legacy /quote endpoint
QUOTE_ATTEMPT_TIMEOUT_S=3
QUOTE_TOTAL_DEADLINE_S=12
QUOTE_MAX_ATTEMPTS=4
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_TIMEOUT_S=30

# Conversation policy
MAX_STALLED_TURNS=3

# Security / PII. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
CONTACT_HASH_SECRET=change-me
ADMIN_API_KEY=

# WhatsApp Cloud API (optional: without a token, outbound messages are simulated/logged)
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
